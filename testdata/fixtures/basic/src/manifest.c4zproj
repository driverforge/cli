<Driver type="c4z" name="fixture-driver" squishLua="true">
  <Items>
    <Item type="dir" c4zDir="www" name="www" recurse="true" exclude="false"/>
    <Item type="dir" c4zDir="vendor" name="vendor" recurse="false" exclude="false"/>
    <Item type="file" name="driver.lua"/>
    <Item type="file" name="driver.xml"/>
  </Items>
</Driver>
